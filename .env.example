# ==========================================
# Vite & Vercel Environment Variables Example
# Copy this file to .env or .env.local and fill in your values.
# ==========================================

# Application Meta & URL Config
VITE_APP_TITLE="Madeswaran JV — Portfolio"
VITE_SITE_URL="https://your-portfolio.vercel.app"

# Social & Contact Info Configuration
VITE_CONTACT_EMAIL="your-email@example.com"
VITE_GITHUB_USERNAME="your-github-handle"
VITE_LINKEDIN_URL="https://linkedin.com/in/your-profile"

# Backend & External API Configuration
VITE_API_URL=""
VITE_API_BASE_URL=""

# Email Service Integration (Optional)
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
VITE_WEB3FORMS_ACCESS_KEY=""

# Analytics (Optional)
VITE_GA_MEASUREMENT_ID=""
